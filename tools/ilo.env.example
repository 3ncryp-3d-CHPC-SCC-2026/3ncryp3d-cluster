# iLO (BMC) addresses for power-monitor.sh. Copy to tools/ilo.env.
# tools/ilo.env and the password file are git-ignored: never commit them.
declare -A NODES=(
  [node1]="192.0.2.11"   # replace with node1's iLO IP
  [node2]="192.0.2.12"   # replace with node2's iLO IP
  [node3]="192.0.2.13"   # replace with node3's iLO IP
)
# A read-only iLO account is enough (iLO: Administration > User Management,
# no config/admin privileges). Do not use the factory Administrator account.
ILO_USER="monitor"
# File containing only the password, chmod 600, outside the repo.
ILO_PASS_FILE="$HOME/.config/3ncryp3d/ilo-pass"
