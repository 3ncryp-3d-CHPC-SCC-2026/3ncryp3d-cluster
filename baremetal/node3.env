# node3 - storage + gateway. Broadcom BCM57504 4-port SFP28 (P26269-B21)
NODE_NAME=node3
ROLE=head
# Real 10G DAC links: jumbo frames (both ends of every cable use 9000).
MESH_MTU=9000
SLOTS=16                      # EPYC 9135 = 16 cores
DNS_SERVERS="8.8.8.8 1.1.1.1" # change to venue DNS if required
CLUSTER_USER=ubuntu           # the login user created at Ubuntu install
# Port3: R9F87A 1G SFP RJ45 transceiver, venue uplink (DHCP)
UPLINK_MAC=XX:XX:XX:XX:XX:23
#        Port1 -> node2                          Port2 -> node1
LINKS="XX:XX:XX:XX:XX:21|10.0.23.3/24|node2|10.0.23.2 XX:XX:XX:XX:XX:22|10.0.31.3/24|node1|10.0.31.1"
HOSTS="10.0.31.1|node1 10.0.23.2|node2 10.0.31.3|node3"
NFS_CLIENTS="10.0.31.1 10.0.23.2"
LOCAL_VOLUMES=""
# The 2x480GB SSD HW RAID 0 virtual drive on the MR408i-o (NOT the OS drive!)
# Find it with: lsblk -o NAME,SIZE,MODEL,SERIAL   then use its /dev/disk/by-id path
SHARED_VOLUMES="/dev/disk/by-id/REPLACE-WITH-SSD-RAID0-DRIVE"
