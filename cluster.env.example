# 3ncryp+3d cluster on OpenStack - configuration
# Copy to cluster.env and edit. cluster.env is read by create_cluster.sh,
# destroy_cluster.sh. Do NOT put passwords here: OpenStack auth comes from
# your sourced openrc file or clouds.yaml (OS_* variables / OS_CLOUD).

# Every OpenStack resource the scripts create is named "<PREFIX>-...".
PREFIX="3n3d"

# ---- Image and flavors -------------------------------------------------
# Real nodes: Ubuntu Server 24.04 LTS.
IMAGE="Ubuntu-24.04"
# Real nodes (HPE quote): 1x EPYC 9135 = 16 cores, 2x 32 GB DDR5-6400 = 64 GB each. Pick the closest
# flavor your project allows; the script warns if it is smaller.
FLAVOR_COMPUTE="m1.xlarge"   # node1, node2
FLAVOR_HEAD="m1.xlarge"      # node3 (storage + gateway)

# ---- Uplink (Node 3 "Port 3", the venue 1G RJ45 link) -------------------
# Option A (default): the script builds a "venue" network + router to the
# external network below, and gives node3 a floating IP.
EXTERNAL_NETWORK="public"
VENUE_CIDR="192.168.30.0/24"
DNS_SERVERS="8.8.8.8 1.1.1.1"
# Option B: attach node3 straight to an existing network instead (no router,
# no floating IP). Leave empty for option A.
VENUE_NETWORK=""

# Who may SSH into node3 from outside. REQUIRED. Use your own /32.
ALLOWED_SSH_CIDR=""

# Public key you will log in with (uploaded as an OpenStack keypair).
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"
# Matching private key, used by the script to check the build.
SSH_PRIVATE_KEY_FILE="$HOME/.ssh/id_ed25519"

# ---- Mesh links (the 1m DAC cables) - keep these as designed ------------
LINK_12_CIDR="10.0.12.0/24"   # node1 <-> node2  MPI
LINK_23_CIDR="10.0.23.0/24"   # node2 <-> node3  NFS for node2
LINK_31_CIDR="10.0.31.0/24"   # node3 <-> node1  NFS for node1
# auto: disable port security on mesh networks (like a bare cable), fall back
# to allowed-address-pairs if your cloud's policy forbids that.
MESH_PORT_SECURITY="auto"

# ---- Storage -----------------------------------------------------------
# Node 3 shared array: real = 2x 480 GB SATA SSD, RAID 0, NFS /mnt/shared.
SHARED_DISKS=2
SHARED_DISK_GB=480
SHARED_VOLUME_TYPE=""        # e.g. an SSD-backed Cinder type; empty = default
# Per-node local array: real = 2x 300 GB SAS HDD, RAID 0 (OS + scratch).
# In the cloud the OS lives on the root disk, so these become /scratch,
# which is also where finished results get backed up to.
LOCAL_DISKS=2                # set 0 to use a folder on the root disk
LOCAL_DISK_GB=300
LOCAL_VOLUME_TYPE=""

# ---- Checks ------------------------------------------------------------
# Targets from the design report. On shared cloud hardware these are reported
# as WARN (not FAIL) when missed, because virtual NICs/disks are not DAC/SSD.
MIN_LINK_GBPS=9
MIN_NFS_MBPS=600
# Minutes to wait for all nodes to finish first-boot setup.
BOOTSTRAP_TIMEOUT_MIN=40
