# node1 - compute. Broadcom BCM57412 2-port SFP+ (P26256-B21)
# Fill MACs from: ip -br link
NODE_NAME=node1
ROLE=compute
# Real 10G DAC links: jumbo frames (both ends of every cable use 9000).
MESH_MTU=9000
SLOTS=16                      # EPYC 9135 = 16 cores
DNS_SERVERS="8.8.8.8 1.1.1.1" # change to venue DNS if required
CLUSTER_USER=ubuntu           # the login user created at Ubuntu install
DEFAULT_GW=10.0.31.3
NFS_SERVER=10.0.31.3
#        Port1 -> node3                          Port2 -> node2
LINKS="XX:XX:XX:XX:XX:01|10.0.31.1/24|node3|10.0.31.3 XX:XX:XX:XX:XX:02|10.0.12.1/24|node2|10.0.12.2"
HOSTS="10.0.31.1|node1 10.0.12.2|node2 10.0.31.3|node3"
# OS + scratch share the 2x300GB HDD HW RAID 0 drive, so /scratch is a folder
LOCAL_VOLUMES=""
