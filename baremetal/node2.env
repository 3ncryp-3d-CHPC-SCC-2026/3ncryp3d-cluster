# node2 - compute. Broadcom BCM57412 2-port SFP+ (P26256-B21)
NODE_NAME=node2
ROLE=compute
# Real 10G DAC links: jumbo frames (both ends of every cable use 9000).
MESH_MTU=9000
SLOTS=16                      # EPYC 9135 = 16 cores
DNS_SERVERS="8.8.8.8 1.1.1.1" # change to venue DNS if required
CLUSTER_USER=ubuntu           # the login user created at Ubuntu install
DEFAULT_GW=10.0.23.3
NFS_SERVER=10.0.23.3
#        Port1 -> node1                          Port2 -> node3
LINKS="XX:XX:XX:XX:XX:11|10.0.12.2/24|node1|10.0.12.1 XX:XX:XX:XX:XX:12|10.0.23.2/24|node3|10.0.23.3"
HOSTS="10.0.12.1|node1 10.0.23.2|node2 10.0.23.3|node3"
LOCAL_VOLUMES=""
